DATABASE_URL=sqlite:///./data/foodbridge.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
DEMO_DATA=false
ENVIRONMENT=development
# Optional catalogue invalidation push. Mount the service-account JSON outside
# source/image (read-only in Docker); it must match the Android Firebase project.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
# Set this only inside the API runtime after mounting a service-account secret.
GOOGLE_APPLICATION_CREDENTIALS=
# Host-side path used by tools/start-local.ps1; keep the JSON file out of Git and Docker images.
FIREBASE_SERVICE_ACCOUNT_FILE=
